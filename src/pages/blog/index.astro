---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="Blog" description="Writing about what I build and what I learn.">
  <h1 class="my-10 mb-6 text-3xl">blog</h1>
  <ul class="flex flex-col gap-8 list-none m-0 p-0">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="text-[1.25rem] font-bold">
            {post.data.title}
          </a>
          <p class="text-muted my-1.5 mb-1">{post.data.description}</p>
          <time datetime={post.data.pubDate.toISOString()} class="text-muted text-[0.85rem]">
            {post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </li>
      ))
    }
  </ul>
</Base>
