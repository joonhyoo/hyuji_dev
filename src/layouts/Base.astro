---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'hyuji.dev',
  description = 'Joon Yoo, a full-stack developer and recent CS grad.',
} = Astro.props;

const pageTitle = title === 'hyuji.dev' ? title : `${title} · hyuji.dev`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="hyuji.dev" href="/rss.xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main class="flex-1">
      <div class="mx-auto max-w-[720px] px-5">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
