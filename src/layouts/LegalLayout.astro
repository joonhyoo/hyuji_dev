---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="legal">
    <slot />
  </article>
</Base>

<style>
  .legal :global(h1) {
    font-size: 1.875rem;
    margin: 2.5rem 0 1.5rem;
  }

  .legal :global(h2) {
    font-size: 1.2rem;
    margin: 1.75rem 0 0.5rem;
  }

  .legal :global(h3) {
    font-weight: 600;
    margin: 1rem 0 0.25rem;
  }

  .legal :global(p) {
    margin: 0.5rem 0;
  }

  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }
</style>
