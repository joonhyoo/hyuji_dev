---
const social = [
  {
    href: 'https://github.com/joonhyoo',
    label: 'GitHub',
    icon: 'M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.7 1.6.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.9 5.6-5.6 5.9.5.4.9 1.2.9 2.3v3.4c0 .3.2.7.8.6A12 12 0 0 0 12 .3z',
    account: 'joonhyoo'
  },
  {
    href: 'https://www.linkedin.com/in/joonhyoo',
    label: 'LinkedIn',
    icon: 'M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6h.1c.5-.9 1.7-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5v6.3zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.5H3.5V9h3.6v11.5z',
    account: 'joonhyoo'
  },
];

const legal = [
  { href: '/terms/', label: 'Terms of Service' },
  { href: '/privacy/', label: 'Privacy Policy' },
];
---

<footer class="border-t border-border mt-16 py-8 text-sm">
  <div class="mx-auto max-w-[720px] px-5">
    <ul class="flex flex-wrap items-center justify-center gap-3 list-none m-0 p-0">
      {
        social.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="me noopener"
              title={item.label}
              class="flex items-center gap-2 text-muted hover:text-text hover:border-muted hover:no-underline"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d={item.icon} />
              </svg>
              <span class="sr-only">{item.label}</span>
              <span>{item.account}</span>
            </a>
          </li>
        ))
      }
      <li class="w-px h-5 bg-border" aria-hidden="true"></li>
      {
        legal.map((item) => (
          <li>
            <a href={item.href} class="text-[0.85rem] text-muted">{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
